AZURE_OPENAI_ENDPOINT=https://<repo>.openai.azure.com
AZURE_OPENAI_API_KEY=<cle>
# Nom du DÉPLOIEMENT (pas du modèle) créé dans Azure AI Foundry
CHAT_DEPLOYMENT=gpt-5.4-mini-2

# --- MySQL : l'utilisateur en LECTURE SEULE créé par sql/01_schema.sql ---
MYSQL_HOST=<host>
MYSQL_PORT=<port>
MYSQL_USER=<user>
MYSQL_PASSWORD=<password>
MYSQL_DATABASE=<database>

# --- RAG : dossier contenant les PDF à indexer (relatif au répertoire de lancement ou absolu) ---
RAG_DOSSIER_PDF=<fiches_fournisseurs>